# Copy this file to `.env` (or `.env.local`) and fill in real values.
# These are read at module load by the API routes / server actions, so all of
# them must be present for the app to start and for `next build` to succeed.

# Neo4j graph database connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# MongoDB document store (opinions). The connection string is assembled as:
#   mongodb+srv://<USER>:<PASS>@<HOST>/<DATABASE>?authSource=admin&replicaSet=...
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=
MONGODB_DATABASE=

# OpenAI (embeddings + summarization)
OPENAI_API_KEY=

# Pinecone (vector search)
PINECONE_API_KEY=
